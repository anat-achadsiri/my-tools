<Window x:Class="SoftSnapWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoftSnap" Width="1060" Height="860" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0C0A1A"
        x:Name="MainWin"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Flat toolbar button (Windows Explorer style) -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator line -->
        <Style x:Key="ToolbarSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#30000000"/>
            <Setter Property="Margin" Value="4,6"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Address bar -->
            <RowDefinition Height="*"/>     <!-- Gallery -->
            <RowDefinition Height="28"/>    <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Toolbar (flat, like Explorer) ══ -->
        <Border x:Name="ToolbarBorder" Grid.Row="0" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,2">
                <Button Style="{StaticResource ToolbarButton}" Click="CaptureFullBtn_Click" ToolTip="Capture Full Screen (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4F7;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Capture" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="CaptureRegionBtn_Click" ToolTip="Capture Region">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2702;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Region" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="CaptureWindowBtn_Click" ToolTip="Capture Window (F6)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1FA9F;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Window" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}" Click="PasteBtn_Click" ToolTip="Paste from Clipboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4CB;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Paste" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="CopySelBtn_Click" ToolTip="Copy Selected Paths (ตามลำดับที่แสดง)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C4;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Copy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="DeleteSelBtn_Click" ToolTip="Delete Selected">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F5D1;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="SortToggleBtn" Style="{StaticResource ToolbarButton}"
                        Click="SortToggleBtn_Click" ToolTip="สลับลำดับการแสดงผล">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2195;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="SortToggleLabel" Text="ใหม่→เก่า" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button x:Name="ThemeBtn" Content="&#x263D;"
                        Style="{StaticResource ToolbarButton}"
                        FontSize="14" Padding="8,2" Click="ThemeBtn_Click"
                        ToolTip="สลับธีม มืด/สว่าง"/>
            </StackPanel>
        </Border>

        <!-- ══ Address Bar (album tabs + path) ══ -->
        <Border x:Name="AddressBar" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                Padding="6,3">
            <DockPanel>
                <!-- Album pill tabs + overflow dropdown (เต็มความกว้าง) -->
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="AlbumTabs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Overflow dropdown for many albums -->
                    <Border x:Name="AlbumOverflowBtn" Visibility="Collapsed"
                            CornerRadius="14" Padding="10,5" Margin="0,0,4,0"
                            Cursor="Hand" Background="#EBEBF0"
                            MouseLeftButtonDown="AlbumOverflowBtn_Click">
                        <TextBlock x:Name="AlbumOverflowText" Text="&#x25BE; +0"
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#555"/>
                    </Border>

                    <!-- New album pill -->
                    <Border x:Name="AddAlbumPill"
                            CornerRadius="14" Padding="10,5" Margin="0,0,4,0"
                            Cursor="Hand" Background="#EBEBF0" ToolTip="สร้าง Album ใหม่"
                            MouseLeftButtonDown="AddAlbumPill_Click">
                        <TextBlock x:Name="AddAlbumPillText" Text="&#x2795;"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#555"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Popup for overflow albums -->
                    <Popup x:Name="AlbumPopup" StaysOpen="True" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=AlbumOverflowBtn}"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="AlbumPopupBorder" Background="White" CornerRadius="8"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Padding="4" MinWidth="230">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Search box (type to filter albums) -->
                                <Border x:Name="AlbumSearchBorder" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="#D5D5D5" Background="#FFFFFF"
                                        Margin="2,2,2,4" Padding="7,4">
                                    <DockPanel>
                                        <TextBlock x:Name="AlbumSearchIcon" Text="&#x1F50D;" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.55"/>
                                        <TextBox x:Name="AlbumSearchBox" BorderThickness="0" Background="Transparent"
                                                 FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"
                                                 TextChanged="AlbumSearchBox_TextChanged"
                                                 PreviewKeyDown="AlbumSearchBox_PreviewKeyDown"/>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer x:Name="AlbumPopupScroll" MaxHeight="400"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AlbumPopupItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Hidden ComboBox to keep existing code working -->
                <ComboBox x:Name="AlbumCombo" Visibility="Collapsed"
                          SelectionChanged="AlbumCombo_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- ══ Folder tree sidebar + Gallery ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: folder tree (explorer-style) -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="#FFFFFF"
                    BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="TreeCountLabel" DockPanel.Dock="Bottom" Text=""
                               FontFamily="Segoe UI" FontSize="11" Foreground="#666"
                               Margin="10,4,10,6"/>
                    <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent"
                              Padding="2,6,2,2"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="False"/>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"/>

            <Border x:Name="GalleryBorder" Grid.Column="2" Background="#FFFFFF">
            <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseLeftButtonDown="GalleryScroll_PreviewMouseDown"
                          PreviewMouseMove="GalleryScroll_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="GalleryScroll_PreviewMouseUp">
                <Grid>
                    <ItemsControl x:Name="GalleryItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="180" Margin="8,8,8,0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- Rubber-band selection overlay -->
                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Border x:Name="SelectionRect" Visibility="Collapsed"
                                Background="#330078D7" BorderBrush="#0078D7"
                                BorderThickness="1"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ Status Bar ══ -->
        <Border x:Name="BottomBar" Grid.Row="3" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <CheckBox x:Name="SelectAllCheck" DockPanel.Dock="Left" Content="เลือกทั้งหมด"
                          Foreground="#333" FontFamily="Segoe UI" FontSize="11"
                          VerticalContentAlignment="Center"
                          Click="SelectAllCheck_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HiddenToggleBtn" Content="กลุ่มที่ซ่อน"
                            Style="{StaticResource ToolbarButton}" Click="HiddenToggleBtn_Click"
                            FontSize="10" Padding="6,2" Margin="0,0,10,0" Visibility="Collapsed"
                            ToolTip="แสดง/ซ่อน กลุ่มที่ถูกซ่อนไว้"/>
                    <TextBlock x:Name="PathLabel" Text="" Foreground="#999"
                               FontFamily="Segoe UI" FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    <TextBlock x:Name="CountLabel" Text="0"
                               Foreground="#666" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,14,0"/>
                    <TextBlock x:Name="SelInfoLabel" Text="" Foreground="#666"
                               FontFamily="Segoe UI" FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Text="&#x2713; Ready"
                           Foreground="#107C10" FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center" Margin="16,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

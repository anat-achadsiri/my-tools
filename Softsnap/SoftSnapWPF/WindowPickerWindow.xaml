<Window x:Class="SoftSnapWPF.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เลือกหน้าต่าง — SoftSnap" Width="520" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinWidth="400" MinHeight="350"
        Background="#1E1E2E"
        PreviewKeyDown="Window_KeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="&#x1FA9F;  เลือกหน้าต่างที่ต้องการ Capture"
                       Foreground="White" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="คลิกเลือกหน้าต่าง แล้วกด Capture หรือ Double-click"
                       Foreground="#999" FontFamily="Segoe UI" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Window list -->
        <Border Grid.Row="1" Background="#282838" CornerRadius="8" BorderBrush="#3A3A4A" BorderThickness="1">
            <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single" MouseDoubleClick="WindowList_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#406366F1"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RefreshBtn" Content="&#x1F504; รีเฟรช" Click="RefreshBtn_Click"
                    Background="#383848" Foreground="White" FontFamily="Segoe UI" FontSize="12"
                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CancelBtn" Content="ยกเลิก" Click="CancelBtn_Click"
                    Background="#383848" Foreground="#CCC" FontFamily="Segoe UI" FontSize="12"
                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CaptureBtn" Content="&#x1F4F7; Capture" Click="CaptureBtn_Click"
                    Background="#6366F1" Foreground="White" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                    Padding="20,8" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
